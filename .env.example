# ==============================================================================
# PULSE CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure the appropriate credentials.
# ==============================================================================

# Core Database Connection (PostgreSQL - Neon, Supabase, or self-hosted)
DATABASE_URL="postgresql://username:password@hostname:5432/databasename?sslmode=require"

# NextAuth / Auth.js Session Security
# Generate a secure key using `openssl rand -base64 32`
NEXTAUTH_SECRET="your-secure-random-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Application Environment (development | production | test)
NODE_ENV="development"

# ------------------------------------------------------------------------------
# Optional Third-Party Service Integrations
# ------------------------------------------------------------------------------

# Transactional Email Service (Resend)
# Required for sending real transactional emails (welcome messages, password resets)
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuv"
EMAIL_FROM="Pulse CRM <notifications@yourcompany.com>"

# SMS Gateway (Twilio)
# Required for customer SMS alerts and automated reminders
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Payment Gateway (Razorpay)
# Required for online invoice payment link generation
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
