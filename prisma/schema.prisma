generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES_EXECUTIVE
  SUPPORT_AGENT
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum ClientSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  SOCIAL_MEDIA
  EVENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  CONVERTED
  LOST
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  TASK
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
}

enum PipelineStage {
  NEW
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  TECHNICAL
  BILLING
  GENERAL
  FEATURE_REQUEST
  OTHER
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(SALES_EXECUTIVE)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  employeeId    String?   @unique
  department    String?
  phone         String?
  joiningDate   DateTime? @default(now())
  notifyOnLeadAssigned Boolean @default(true)
  notifyOnDealUpdates  Boolean @default(true)
  notifyOnFollowUps    Boolean @default(true)
  notifyOnTickets      Boolean @default(true)
  notifyOnPayments     Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  passwordResetTokens PasswordResetToken[]
  assignedClients     Client[]             @relation("AssignedClients")
  createdClients      Client[]             @relation("CreatedClients")
  assignedLeads       Lead[]               @relation("AssignedLeads")
  createdLeads        Lead[]               @relation("CreatedLeads")
  assignedFollowUps   FollowUp[]           @relation("AssignedFollowUps")
  createdFollowUps    FollowUp[]           @relation("CreatedFollowUps")
  assignedDeals       Deal[]               @relation("AssignedDeals")
  createdDeals        Deal[]               @relation("CreatedDeals")
  createdQuotations   Quotation[]          @relation("CreatedQuotations")
  createdInvoices     Invoice[]            @relation("CreatedInvoices")
  recordedPayments    Payment[]            @relation("RecordedPayments")
  assignedTickets     SupportTicket[]      @relation("AssignedTickets")
  createdTickets      SupportTicket[]      @relation("CreatedTickets")
  ticketReplies       TicketReply[]
  notifications       Notification[]
  apiKeys             ApiKey[]
  activityLogs        ActivityLog[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id           String       @id @default(uuid())
  companyName  String
  industry     String?
  website      String?
  email        String?
  phone        String?
  addressLine  String?
  city         String?
  state        String?
  postalCode   String?
  country      String?      @default("India")
  status       ClientStatus @default(PROSPECT)
  source       ClientSource @default(OTHER)
  notes        String?      @db.Text
  assignedToId String
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignedTo         User       @relation("AssignedClients", fields: [assignedToId], references: [id])
  createdBy          User       @relation("CreatedClients", fields: [createdById], references: [id])
  contacts           Contact[]
  convertedFromLeads Lead[]     @relation("ConvertedLead")
  followUps          FollowUp[]
  deals              Deal[]
  quotations         Quotation[]
  invoices           Invoice[]
  payments           Payment[]
  tickets            SupportTicket[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model Contact {
  id          String   @id @default(uuid())
  clientId    String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())

  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tickets SupportTicket[]
}

model Lead {
  id                String       @id @default(uuid())
  name              String
  companyName       String?
  email             String?
  phone             String?
  source            ClientSource @default(OTHER)
  status            LeadStatus   @default(NEW)
  estimatedValue    Decimal?     @db.Decimal(12, 2)
  notes             String?      @db.Text
  assignedToId      String
  createdById       String
  convertedClientId String?
  lostReason        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  assignedTo      User       @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy       User       @relation("CreatedLeads", fields: [createdById], references: [id])
  convertedClient Client?    @relation("ConvertedLead", fields: [convertedClientId], references: [id])
  followUps       FollowUp[]

  @@index([status])
  @@index([assignedToId])
  @@index([source])
}

model FollowUp {
  id                String             @id @default(uuid())
  title             String
  description       String?            @db.Text
  type              FollowUpType       @default(TASK)
  dueDate           DateTime
  status            FollowUpStatus     @default(PENDING)
  leadId            String?
  clientId          String?
  assignedToId      String
  createdById       String
  isRecurring       Boolean            @default(false)
  recurrencePattern RecurrencePattern?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  lead       Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client     Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo User    @relation("AssignedFollowUps", fields: [assignedToId], references: [id])
  createdBy  User    @relation("CreatedFollowUps", fields: [createdById], references: [id])

  @@index([assignedToId])
  @@index([dueDate])
  @@index([status])
}

model Deal {
  id                String        @id @default(uuid())
  title             String
  clientId          String
  value             Decimal       @db.Decimal(12, 2)
  stage             PipelineStage @default(NEW)
  probability       Int           @default(10)
  expectedCloseDate DateTime?
  notes             String?       @db.Text
  lostReason        String?
  assignedToId      String
  createdById       String
  wonAt             DateTime?
  lostAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo User        @relation("AssignedDeals", fields: [assignedToId], references: [id])
  createdBy  User        @relation("CreatedDeals", fields: [createdById], references: [id])
  quotations Quotation[]
  invoices   Invoice[]

  @@index([stage])
  @@index([assignedToId])
  @@index([clientId])
}

model Quotation {
  id                 String          @id @default(uuid())
  quotationNumber    String          @unique
  clientId           String
  dealId             String?
  status             QuotationStatus @default(DRAFT)
  issueDate          DateTime        @default(now())
  validUntil         DateTime?
  subtotal           Decimal         @default(0) @db.Decimal(12, 2)
  taxPercent         Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(12, 2)
  discountPercent    Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount     Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal         @default(0) @db.Decimal(12, 2)
  notes              String?         @db.Text
  termsAndConditions String?         @db.Text
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal      Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy User            @relation("CreatedQuotations", fields: [createdById], references: [id])
  items     QuotationItem[]
  invoices  Invoice[]       @relation("QuotationInvoices")
}

model QuotationItem {
  id          String  @id @default(uuid())
  quotationId String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  clientId           String
  quotationId        String?
  dealId             String?
  status             InvoiceStatus @default(DRAFT)
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  subtotal           Decimal       @default(0) @db.Decimal(12, 2)
  taxPercent         Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent    Decimal       @default(0) @db.Decimal(5, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(12, 2)
  notes              String?       @db.Text
  termsAndConditions String?       @db.Text
  createdById        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quotation Quotation?    @relation("QuotationInvoices", fields: [quotationId], references: [id], onDelete: SetNull)
  deal      Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy User          @relation("CreatedInvoices", fields: [createdById], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@index([status])
  @@index([clientId])
  @@index([dueDate])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @default(0) @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(uuid())
  receiptNumber   String        @unique
  invoiceId       String
  clientId        String
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  paymentDate     DateTime      @default(now())
  referenceNumber String?
  notes           String?       @db.Text
  recordedById    String
  createdAt       DateTime      @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("RecordedPayments", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([clientId])
  @@index([paymentDate])
}

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique
  clientId     String
  contactId    String?
  subject      String
  description  String         @db.Text
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  category     TicketCategory @default(GENERAL)
  assignedToId String?
  createdById  String
  dueBy        DateTime
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdBy  User          @relation("CreatedTickets", fields: [createdById], references: [id])
  replies    TicketReply[]

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
}

model TicketReply {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  message    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])
}

enum NotificationType {
  LEAD_ASSIGNED
  DEAL_STAGE_CHANGED
  DEAL_WON
  FOLLOW_UP_DUE
  INVOICE_OVERDUE
  TICKET_ASSIGNED
  TICKET_REPLY
  PAYMENT_RECEIVED
  GENERAL
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model ApiKey {
  id          String    @id @default(uuid())
  key         String    @unique
  label       String
  isActive    Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([key, isActive])
  @@index([createdById])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  description String   @db.Text
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
}


